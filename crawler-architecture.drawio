<mxfile host="Electron">
  <diagram id="crawler-architecture" name="Crawler architecture">
    <mxGraphModel dx="990" dy="642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="source" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;Source sites&lt;/b&gt;&lt;br&gt;source-sites.csv" vertex="1">
          <mxGeometry height="70" width="160" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="frontier" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="&lt;b&gt;Frontier queue&lt;/b&gt;&lt;br&gt;frontier-queue.csv" vertex="1">
          <mxGeometry height="70" width="160" x="280" y="100" as="geometry" />
        </mxCell>
        <mxCell id="fetch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="&lt;b&gt;Fetch page&lt;/b&gt;&lt;br&gt;pop url, requests.get&lt;br&gt;timeout 10 s, delay 3 s" vertex="1">
          <mxGeometry height="70" width="180" x="520" y="100" as="geometry" />
        </mxCell>
        <mxCell id="extract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="&lt;b&gt;Extract links&lt;/b&gt;&lt;br&gt;fetchURLs, domain and&lt;br&gt;visited filter" vertex="1">
          <mxGeometry height="70" width="180" x="780" y="100" as="geometry" />
        </mxCell>
        <mxCell id="visited" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;Visited urls file&lt;/b&gt;&lt;br&gt;visited-sites.csv" vertex="1">
          <mxGeometry height="70" width="170" x="400" y="280" as="geometry" />
        </mxCell>
        <mxCell id="folder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;Local folder&lt;/b&gt;&lt;br&gt;data/*.html" vertex="1">
          <mxGeometry height="70" width="170" x="660" y="280" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#000000;" value="Repeat until queue is empty or ITERATIONS is reached" vertex="1">
          <mxGeometry height="50" width="430" x="400" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;" target="frontier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="frontier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;" target="fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;" target="extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;labelBackgroundColor=none;" target="frontier" value="new links go back to the queue">
          <mxGeometry relative="1" x="-0.0163" y="-10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="870" y="50" />
              <mxPoint x="360" y="50" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;labelBackgroundColor=none;" target="visited" value="then mark url done">
          <mxGeometry relative="1" x="0.0385" y="-15" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;labelBackgroundColor=none;" target="folder" value="save content">
          <mxGeometry relative="1" x="-0.0092" y="15" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
